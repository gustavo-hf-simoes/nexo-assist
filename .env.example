# Banco (a senha abaixo é só de desenvolvimento local)
# Porta do Postgres no host. Se a 5432 estiver ocupada, use POSTGRES_PORT=5433 e troque a porta nas duas URLs abaixo.
# POSTGRES_PORT=5432
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo_dev
APP_DATABASE_URL=postgres://nexo:nexo_dev@127.0.0.1:5432/nexo_app
TICKETS_DATABASE_URL=postgres://nexo:nexo_dev@127.0.0.1:5432/nexo_tickets

# Serviço de chamados
TICKET_SERVICE_URL=http://localhost:4010
TICKET_SERVICE_TOKEN=troque-por-um-token-longo
TICKET_SERVICE_FAILURE_RATE=0.1
TICKET_SERVICE_LATENCY_MS=150
PORT=4010

# Sessão: mínimo de 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=

# Agent (Google Gemini). A chave é obrigatória, exceto quando NEXO_AGENT_MODEL começa com test/
GOOGLE_GENERATIVE_AI_API_KEY=
NEXO_AGENT_MODEL=google/gemini-3.8-flash
AGENT_MIN_CONFIDENCE=0.6

# Eval das decisões (npm run eval): taxa mínima de aprovação, de 0 a 1. O eval chama o Gemini de verdade e não roda no CI.
EVAL_MIN_PASS_RATE=0.9

# Limites
SESSION_MESSAGE_LIMIT=30
DAILY_LLM_TURN_LIMIT=500
